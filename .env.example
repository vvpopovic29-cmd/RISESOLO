# =============================================================================
# RISESOLO - primer environment fajla (bez tajnih vrednosti)
# Kopiraj u .env i prilagodi lokalno. Ne komituj stvarni .env fajl.
# =============================================================================

# --- apps/api (NestJS) -------------------------------------------------------
NODE_ENV=development
PORT=3000

# PostgreSQL (Prisma) - baza i korisnik moraju vec postojati lokalno, vidi
# "Baza podataka (PostgreSQL/Prisma)" u README-u. Isti korisnik/lozinka se
# koriste i za `risesolo_test` (e2e testovi) - ne za DATABASE_URL, koji
# ostaje usmeren na dev bazu.
DATABASE_URL=postgresql://risesolo:risesolo@localhost:5432/risesolo

# Koristice se u kasnijoj fazi (BullMQ) - postavljen ovde samo da Zod env
# sema ima predvidljiv oblik.
REDIS_URL=redis://localhost:6379

# JWT potpisivanje (auth, Faza 2). Za lokalni razvoj bilo koja vrednost radi -
# NIKAD ne koristiti ovu vrednost u produkciji.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# --- apps/mobile (Expo) -------------------------------------------------------
# Mora poceti sa EXPO_PUBLIC_ da bi bilo dostupno u klijentskom bundle-u.
EXPO_PUBLIC_API_URL=http://localhost:3000
