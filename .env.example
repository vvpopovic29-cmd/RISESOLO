# =============================================================================
# RISESOLO - primer environment fajla (bez tajnih vrednosti)
# Kopiraj u .env i prilagodi lokalno. Ne komituj stvarni .env fajl.
# =============================================================================

# --- apps/api (NestJS) -------------------------------------------------------
NODE_ENV=development
PORT=3000

# Koristice se u kasnijim fazama (Prisma / PostgreSQL direktna konekcija, Redis, BullMQ).
# Postavljeni su ovde samo da bi Zod env sema imala predvidljiv oblik.
DATABASE_URL=postgresql://risesolo:risesolo@localhost:5432/risesolo
REDIS_URL=redis://localhost:6379

# Supabase projekat "RISESOLO" (Faza 2 - vidi supabase/README.md za semu).
# SUPABASE_SERVICE_ROLE_KEY ZAOBILAZI RLS - koristi ga SAMO na backend-u
# (apps/api), NIKAD u mobilnoj app-i. Pravu vrednost uzmi iz
# Supabase dashboard-a (Project Settings -> API) - ovde je namerno
# placeholder, ne prava tajna vrednost.
SUPABASE_URL=https://whswkyqewatdgewnknun.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-service-role-key-from-supabase-dashboard

# --- apps/mobile (Expo) -------------------------------------------------------
# Mora poceti sa EXPO_PUBLIC_ da bi bilo dostupno u klijentskom bundle-u.
EXPO_PUBLIC_API_URL=http://localhost:3000

# anon/publishable key je javno bezbedan (RLS ga ogranicava) - sme u klijentski bundle.
EXPO_PUBLIC_SUPABASE_URL=https://whswkyqewatdgewnknun.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uauaUNwlrW-KcYBHRG6C6Q_wpDq7gRv
