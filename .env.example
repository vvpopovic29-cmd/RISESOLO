# =============================================================================
# RISESOLO - primer environment fajla (Faza 1: bez tajnih vrednosti)
# Kopiraj u .env i prilagodi lokalno. Ne komituj stvarni .env fajl.
# =============================================================================

# --- apps/api (NestJS) -------------------------------------------------------
NODE_ENV=development
PORT=3000

# Prisma / PostgreSQL - videti apps/api/prisma/schema.prisma
DATABASE_URL=postgresql://risesolo:risesolo@localhost:5432/risesolo
# Redis - jos nije ozicen (rezervisano za buduce faze - cache/queue).
REDIS_URL=redis://localhost:6379

# JWT auth (apps/api/src/auth) - u produkciji mora biti duga, nasumicna vrednost.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# --- apps/mobile (Expo) -------------------------------------------------------
# Mora poceti sa EXPO_PUBLIC_ da bi bilo dostupno u klijentskom bundle-u.
EXPO_PUBLIC_API_URL=http://localhost:3000
