# =============================================================================
# RISESOLO - primer environment fajla (Faza 1: bez tajnih vrednosti)
# Kopiraj u .env i prilagodi lokalno. Ne komituj stvarni .env fajl.
# =============================================================================

# --- apps/api (NestJS) -------------------------------------------------------
NODE_ENV=development
PORT=3000

# Koristice se u kasnijim fazama (Prisma / PostgreSQL, Redis, BullMQ).
# Postavljeni su ovde samo da bi Zod env sema imala predvidljiv oblik.
DATABASE_URL=postgresql://risesolo:risesolo@localhost:5432/risesolo
REDIS_URL=redis://localhost:6379

# Supabase projekat "RISESOLO" (Faza 2 - gamification core). SUPABASE_URL je
# javna vrednost; SUPABASE_SERVICE_ROLE_KEY je TAJNA - backend je koristi da
# pozove SECURITY DEFINER RPC funkcije, nikad je ne prosledjuj klijentu i ne
# komituj stvarnu vrednost. Uzmi obe iz Supabase dashboard-a (Project
# Settings -> API).
SUPABASE_URL=https://whswkyqewatdgewnknun.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- apps/mobile (Expo) -------------------------------------------------------
# Mora poceti sa EXPO_PUBLIC_ da bi bilo dostupno u klijentskom bundle-u.
EXPO_PUBLIC_API_URL=http://localhost:3000
