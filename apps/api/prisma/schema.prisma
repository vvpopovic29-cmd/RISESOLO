// RISESOLO - Prisma schema (Faza 2: core gameplay loop)
//
// Pravilo iz domain sloja (packages/domain/src/gamification): `total_xp` je
// jedini izvor istine za progres - `level` i `rank` se NIKAD ne cuvaju ovde,
// uvek se izvode u application/API sloju preko `calculateLevel`/`calculateRank`.
// Isto tako, server (NestJS servisi) je jedini autoritet koji sme da menja
// total_xp/coins/stat vrednosti - ovaj model namerno ne izlaze "sirove"
// mutacije klijentu (RLS-ekvivalent se implementira kao ownership provera u
// servisnom sloju, buduci da ne koristimo Supabase RLS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Profile
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile      Profile?
  playerStats  PlayerStats?
  progression  Progression?
  xpEvents     XpEvent[]
  quests       Quest[]
  workouts     Workout[]
  workoutSessions WorkoutSession[]
  trainingPlans   TrainingPlan[]
  nutritionEntries NutritionEntry[]
  guildMembership GuildMembership?
  guildMessages   GuildMessage[]
  subscription    Subscription?
  pushTokens      PushToken[]
  achievements    UserAchievement[]
  cosmetics       UserCosmetic[]
  inventoryItems  InventoryItem[]
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  @@map("users")
}

model Profile {
  userId         String    @id @map("user_id")
  username       String    @unique
  avatarUrl      String?   @map("avatar_url")
  age            Int?
  heightCm       Int?      @map("height_cm")
  weightKg       Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  trainingType   String?   @map("training_type")
  experienceLevel String?  @map("experience_level")
  onboardedAt    DateTime? @map("onboarded_at")
  /// Opremljeni Coin Shop predmeti - String (ne enum/FK) jer katalog zivi u
  /// @risesolo/domain (SHOP_ITEMS), ne u bazi (isti princip kao UserAchievement.achievementId).
  /// `null` = nista opremljeno za tu kategoriju.
  equippedAvatarFrameId String? @map("equipped_avatar_frame_id")
  equippedTitleId       String? @map("equipped_title_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Gamification: stats, progression, xp events
// ---------------------------------------------------------------------------

model PlayerStats {
  userId       String   @id @map("user_id")
  strength     Int      @default(1)
  agility      Int      @default(1)
  endurance    Int      @default(1)
  vitality     Int      @default(1)
  intelligence Int      @default(1)
  statPoints   Int      @default(0) @map("stat_points")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_stats")
}

/// `level`/`rank` su NAMERNO izostavljeni - derived vrednosti iz `totalXp`
/// preko @risesolo/domain (calculateLevel/calculateRank), nikad perzistirane,
/// da ne bi doslo do drift-a (bug ostavi level=6 dok je total_xp vec za level 7).
model Progression {
  userId           String    @id @map("user_id")
  totalXp          Int       @default(0) @map("total_xp")
  coins            Int       @default(0)
  currentStreak    Int       @default(0) @map("current_streak")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progression")
}

enum XpSource {
  WORKOUT_COMPLETE
  DAILY_QUEST_COMPLETE
  BOSS_QUEST_COMPLETE
  WEEKLY_QUEST_COMPLETE
  MAIN_QUEST_COMPLETE
  SIDE_QUEST_COMPLETE
  PENALTY_QUEST_COMPLETE
  AI_QUEST_COMPLETE

  @@map("xp_source")
}

/// Immutable ledger - jedan red po nagradjenom dogadjaju. `sourceId` + unique
/// constraint sprecava duplu nagradu ako isti request (npr. "Complete") stigne
/// vise puta (mrezni retry, dupli tap).
model XpEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  source    XpSource
  sourceId  String   @map("source_id")
  amount    Int
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceId])
  @@index([userId, createdAt])
  @@map("xp_events")
}

// ---------------------------------------------------------------------------
// Exercises
// ---------------------------------------------------------------------------

enum ExerciseType {
  CALISTHENICS
  GYM
  SKILL

  @@map("exercise_type")
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("exercise_difficulty")
}

model Exercise {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  category          String
  subcategory       String?
  type              ExerciseType
  difficulty        ExerciseDifficulty
  equipment         String
  movementPattern   String             @map("movement_pattern")
  primaryMuscles    String[]           @map("primary_muscles")
  secondaryMuscles  String[]           @map("secondary_muscles")
  instructions      String[]
  formCues          String[]           @map("form_cues")
  safetyNotes       String[]           @map("safety_notes")
  defaultSets       Int?               @map("default_sets")
  defaultReps       String?            @map("default_reps")
  holdSeconds       Int?               @map("hold_seconds")
  restSeconds       Int?               @map("rest_seconds")
  progressionChain  String?            @map("progression_chain")
  progressionOrder  Int?               @map("progression_order")
  videoUrl          String?            @map("video_url")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  workoutSets       WorkoutSet[]
  templateUsages    WorkoutTemplateExercise[]

  @@index([category, difficulty])
  @@index([progressionChain, progressionOrder])
  @@map("exercises")
}

// ---------------------------------------------------------------------------
// AI trening planovi
// ---------------------------------------------------------------------------

/// Jedan generisani plan po zahtevu (na zahtev, bez auto-adaptacije - vidi
/// packages/domain/src/training). `content` cuva puni strukturirani plan
/// (dani, vezbe, setovi/ponavljanja) kako ga je AI model vratio - validiran
/// protiv Zod seme pre upisa (packages/validation/src/contracts/training.ts).
model TrainingPlan {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  summary     String?
  daysPerWeek Int      @map("days_per_week")
  content     Json
  model       String
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("training_plans")
}

// ---------------------------------------------------------------------------
// Ishrana (osnovno pracenje)
// ---------------------------------------------------------------------------

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK

  @@map("meal_type")
}

/// Osnovno pracenje ishrane - nova, nezavisna domena (vidi
/// packages/domain/src/nutrition). Namerno bez XP/coin nagrade - cist
/// tracking alat, ne deo core gameplay loop-a. Za razliku od Quest-a,
/// namerno NEMA unique constraint po (userId, date, mealType) - vise unosa
/// istog obroka istog dana je ocekivano i validno.
model NutritionEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  mealType  MealType @map("meal_type")
  name      String
  calories  Int
  proteinG  Int      @map("protein_g")
  carbsG    Int      @map("carbs_g")
  fatG      Int      @map("fat_g")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("nutrition_entries")
}

// ---------------------------------------------------------------------------
// Quests
// ---------------------------------------------------------------------------

enum QuestType {
  DAILY
  WEEKLY
  BOSS
  MAIN
  SIDE
  PENALTY
  AI_GENERATED

  @@map("quest_type")
}

enum QuestStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  EXPIRED

  @@map("quest_status")
}

/// generateDailyQuest/generateBossQuest su idempotentni zahvaljujuci
/// @@unique([userId, date, type]) - druga generacija za isti dan (DAILY) ili
/// nedelju (BOSS, date = ponedeljak te ISO nedelje) vraca postojeci red
/// umesto da pravi duplikat. Boss quest progres se NE cuva ovde - racuna se
/// prebrojavanjem zavrsenih WorkoutSession (vidi @risesolo/domain boss-quest).
model Quest {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  date        DateTime    @db.Date
  type        QuestType
  /// Podtip u okviru `type` (npr. DAILY: "WORKOUT_COMPLETE"/"LOG_NUTRITION") - plain String
  /// katalog u @risesolo/domain, ne Prisma enum, da bi novi kind mogao da se doda bez migracije
  /// (isti princip kao UserAchievement.achievementId i UserCosmetic.itemId).
  kind        String      @default("WORKOUT_COMPLETE")
  title       String
  description String?
  targetReps  Int?        @map("target_reps")
  targetSets  Int?        @map("target_sets")
  xpReward    Int         @map("xp_reward")
  coinReward  Int         @map("coin_reward")
  status      QuestStatus @default(AVAILABLE)
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
  @@map("quests")
}

// ---------------------------------------------------------------------------
// Workouts
// ---------------------------------------------------------------------------

/// Workout = opciona sablon/template definicija (za "Moji treninzi" listu).
/// Sesija (WorkoutSession) je stvarno izvrsenje - moze postojati i bez
/// template-a (ad-hoc trening).
model Workout {
  id        String                    @id @default(cuid())
  userId    String                    @map("user_id")
  name      String
  createdAt DateTime                  @default(now()) @map("created_at")
  updatedAt DateTime                  @updatedAt @map("updated_at")

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  WorkoutSession[]
  exercises WorkoutTemplateExercise[]

  @@map("workouts")
}

/// Vezbe unutar jednog template-a ("Moji treninzi"), u redosledu prikaza.
/// `targetSets` je samo predlog za UI (npr. "3 serije") - stvarne odradjene
/// serije se i dalje logiraju preko WorkoutSet u toku sesije, template ne
/// diktira izvrsenje.
model WorkoutTemplateExercise {
  id         String   @id @default(cuid())
  workoutId  String   @map("workout_id")
  exerciseId String   @map("exercise_id")
  order      Int
  targetSets Int?     @map("target_sets")

  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutId, order])
  @@index([workoutId])
  @@map("workout_template_exercises")
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED

  @@map("workout_session_status")
}

model WorkoutSession {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  workoutId   String?              @map("workout_id")
  status      WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt   DateTime             @default(now()) @map("started_at")
  completedAt DateTime?            @map("completed_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout?             @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  sets        WorkoutSet[]

  @@index([userId, status])
  @@map("workout_sessions")
}

/// Jedna serija jedne vezbe unutar sesije. Gym vezbe koriste
/// reps+weightKg, calisthenics/skill drzanja koriste durationSeconds.
model WorkoutSet {
  id              String         @id @default(cuid())
  sessionId       String         @map("session_id")
  exerciseId      String         @map("exercise_id")
  setNumber       Int            @map("set_number")
  reps            Int?
  weightKg        Decimal?       @map("weight_kg") @db.Decimal(6, 2)
  durationSeconds Int?           @map("duration_seconds")
  completed       Boolean        @default(false)
  createdAt       DateTime       @default(now()) @map("created_at")

  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise        Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  /// Cini logSet idempotentnim na retry (isti set_number za istu vezbu u istoj sesiji = upsert, ne duplikat).
  @@unique([sessionId, exerciseId, setNumber])
  @@map("workout_sets")
}

// ---------------------------------------------------------------------------
// Guild sistem
// ---------------------------------------------------------------------------

enum GuildRole {
  LEADER
  OFFICER
  MEMBER

  @@map("guild_role")
}

/// `total_xp`/`treasury_coins` su jedini izvor istine (isti princip kao
/// licni Progression) - cehovski nivo se uvek izvodi preko @risesolo/domain
/// calculateLevel, nikad ne perzistira posebno.
model Guild {
  id            String   @id @default(cuid())
  name          String   @unique
  tag           String   @unique
  description   String?
  totalXp       Int      @default(0) @map("total_xp")
  treasuryCoins Int      @default(0) @map("treasury_coins")
  createdAt     DateTime @default(now()) @map("created_at")

  members       GuildMembership[]
  messages      GuildMessage[]
  raids         GuildRaid[]

  @@map("guilds")
}

/// Jedan korisnik moze biti u najvise jednom cehu odjednom (`userId` je unique).
model GuildMembership {
  id       String    @id @default(cuid())
  guildId  String    @map("guild_id")
  userId   String    @unique @map("user_id")
  role     GuildRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at")

  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@map("guild_memberships")
}

/// Osnovna komunikacija (Social & Chat) - polled feed, ne real-time (Redis/
/// Socket.IO nisu ozicena u MVP-u - vidi README "Poznata ogranicenja").
model GuildMessage {
  id        String   @id @default(cuid())
  guildId   String   @map("guild_id")
  userId    String   @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@map("guild_messages")
}

enum GuildRaidStatus {
  AVAILABLE
  COMPLETED
  EXPIRED

  @@map("guild_raid_status")
}

/// Nedeljni cehovski izazov (ogledalo licnog Boss Quest-a, agregirano preko
/// svih clanova) - idempotentna generacija preko @@unique([guildId, weekStart]),
/// isti princip kao Quest.date. Progres se NE cuva ovde - racuna se
/// prebrojavanjem zavrsenih WorkoutSession svih clanova (vidi @risesolo/domain guild/raid.ts).
model GuildRaid {
  id                  String          @id @default(cuid())
  guildId             String          @map("guild_id")
  weekStart           DateTime        @map("week_start") @db.Date
  targetContributions Int             @map("target_contributions")
  coinReward          Int             @map("coin_reward")
  status              GuildRaidStatus @default(AVAILABLE)
  completedAt         DateTime?       @map("completed_at")
  createdAt           DateTime        @default(now()) @map("created_at")

  guild               Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, weekStart])
  @@map("guild_raids")
}

// ---------------------------------------------------------------------------
// Subscriptions / RevenueCat
// ---------------------------------------------------------------------------

enum SubscriptionStore {
  APP_STORE
  PLAY_STORE
  STRIPE
  PROMOTIONAL
  UNKNOWN

  @@map("subscription_store")
}

/// RevenueCat je izvor istine - ovaj red se popunjava ISKLJUCIVO preko
/// RevenueCat webhook-a (apps/api/src/subscriptions), nikad direktno od
/// klijenta. `expiresAt` je jedino perzistirano polje koje odredjuje
/// aktivnost (isti princip kao `total_xp`) - da li je pretplata trenutno
/// aktivna se UVEK izvodi preko @risesolo/domain `isEntitlementActive`,
/// nikad ne cuva kao poseban "isActive" boolean.
model Subscription {
  id                    String            @id @default(cuid())
  userId                String            @unique @map("user_id")
  entitlementId         String            @map("entitlement_id")
  productId             String?           @map("product_id")
  store                 SubscriptionStore @default(UNKNOWN)
  expiresAt             DateTime?         @map("expires_at")
  willRenew             Boolean           @default(false) @map("will_renew")
  originalTransactionId String?           @map("original_transaction_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Push notifications
// ---------------------------------------------------------------------------

enum PushPlatform {
  IOS
  ANDROID

  @@map("push_platform")
}

/// Jedan red po fizickom uredjaju (Expo push token), ne po korisniku - isti
/// korisnik moze imati vise uredjaja. `token` je globalno unique (ne
/// userId+token) jer je Expo push token vezan za konkretnu instalaciju
/// aplikacije - ako se drugi korisnik uloguje na istom uredjaju, `upsert`
/// po tokenu prebacuje vlasnistvo (vidi NotificationsService.registerToken).
model PushToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ---------------------------------------------------------------------------
// Achievements / Badges
// ---------------------------------------------------------------------------

/// Trajno otkljucan milestone. `achievementId` je namerno String (ne enum) -
/// katalog achievement-a zivi iskljucivo u @risesolo/domain
/// (ACHIEVEMENT_DEFINITIONS) da bi se novi badge mogao dodati bez migracije;
/// `@@unique([userId, achievementId])` sprecava duplo otkljucavanje istog
/// achievement-a (idempotentno, isti princip kao XpEvent.sourceId).
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ---------------------------------------------------------------------------
// Coin Shop / Avatar Customization
// ---------------------------------------------------------------------------

/// Kupljen kozmeticki predmet (jednom kupljen, zauvek u vlasnistvu - isti
/// princip kao UserAchievement). `itemId` je String (ne enum/FK) - katalog
/// (SHOP_ITEMS) zivi iskljucivo u @risesolo/domain, novi predmet se moze
/// dodati bez migracije. `@@unique([userId, itemId])` sprecava duplu kupovinu
/// (race-safe preko istog constraint-a, ne samo "provera pa upis").
model UserCosmetic {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  itemId      String   @map("item_id")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_cosmetics")
}

// ---------------------------------------------------------------------------
// Inventory (B2) - Hidden Items, Workshop Items, Guild Items, Event Items
// ---------------------------------------------------------------------------

/// Izvor Inventory predmeta - `HIDDEN` (tajni uslovi, vidi @risesolo/domain
/// hidden-item.ts), `WORKSHOP` (unapred vidljiv katalog, izradjuje se preko
/// POST /inventory/workshop/craft uz nivo+coins, vidi workshop-item.ts),
/// `GUILD` (unapred vidljiv katalog, automatski se dodeljuje na osnovu
/// cehovske aktivnosti, GET-only kao Hidden ali bez tajne, vidi guild-item.ts)
/// i `EVENT` (unapred vidljiv katalog, prisvaja se BESPLATNO preko POST
/// /inventory/event/claim ali SAMO unutar godisnjeg kalendarskog prozora,
/// vidi event-item.ts). Ostali izvori (AI_GENERATED/RECOVERY/CUSTOM) se
/// dodaju fazu po fazu preko posebne migracije (isti princip kao QuestType).
enum ItemSource {
  HIDDEN
  WORKSHOP
  GUILD
  EVENT

  @@map("item_source")
}

/// Otkriven Inventory predmet (SECRET dok se ne otkrije) - "derive, don't
/// cache" isti princip kao UserAchievement: server ponovo racuna snapshot i
/// upisuje samo novo otkrivene, nikad ne pretpostavlja otkrivanje klijentski.
/// `itemId` je String (ne enum/FK) - katalog (HIDDEN_ITEM_DEFINITIONS, kasnije
/// katalozi ostalih izvora) zivi iskljucivo u @risesolo/domain, nova stavka se
/// moze dodati bez migracije (isti princip kao UserAchievement.achievementId
/// i UserCosmetic.itemId). `@@unique([userId, itemId])` sprecava duplo
/// otkrivanje (race-safe preko istog constraint-a).
model InventoryItem {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  itemId       String     @map("item_id")
  source       ItemSource
  discoveredAt DateTime   @default(now()) @map("discovered_at")

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// Prijatelji / Rivali
// ---------------------------------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED

  @@map("friendship_status")
}

/// Usmerena veza (requester -> addressee). `status: ACCEPTED` = prijateljstvo,
/// `PENDING` = zahtev na cekanju. Odbijanje/otkazivanje/uklanjanje prijatelja
/// jednostavno brise red (nema istorije) - dozvoljava ponovni zahtev kasnije.
/// `@@unique([requesterId, addresseeId])` sprecava duple zahteve u istom smeru;
/// suprotan smer se proverava u FriendsService pre kreiranja.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}
