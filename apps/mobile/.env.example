# Kopiraj u .env unutar apps/mobile (Expo CLI cita .env samo iz korena ove app).
# Mora poceti sa EXPO_PUBLIC_ da bi bilo dostupno u klijentskom bundle-u.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Opciono - RevenueCat javni (publishable) SDK kljucevi, iz RevenueCat
# Dashboard (Project Settings -> API Keys). Bez njih je PurchasesService
# no-op (vidi src/subscriptions/purchases.ts) - RevenueCat Dashboard/Store
# konfiguracija jos nije zavrsena.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Opciono - Sentry DSN (sentry.io -> Project Settings -> Client Keys), javan
# po dizajnu. Bez njega je monitoring/sentry.ts no-op.
# EXPO_PUBLIC_SENTRY_DSN=
