{
  "name": "@risesolo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist-web",
    "clean": "rimraf dist-web .expo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "eas:login": "npx eas-cli@latest login",
    "eas:init": "npx eas-cli@latest init",
    "build:dev": "npx eas-cli@latest build --profile development",
    "build:preview": "npx eas-cli@latest build --profile preview",
    "build:production": "npx eas-cli@latest build --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@risesolo/api-client": "workspace:*",
    "@risesolo/design-tokens": "workspace:*",
    "@risesolo/validation": "workspace:*",
    "babel-preset-expo": "~57.0.10",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3"
  }
}
